{
  "name": "plumber-website",
  "version": "1.0.0",
  "description": "Professional plumbing service website with booking and Stripe payments",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/styles.css --minify",
    "watch:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/styles.css --watch"
  },
  "dependencies": {
    "express": "^4.18.2",
    "stripe": "^14.10.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1",
    "nodemon": "^3.0.2"
  }
}
